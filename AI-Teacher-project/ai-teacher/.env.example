# Optional configuration. The app runs fully offline with none of this set.

# --- LLM backend (priority: Anthropic > OpenAI > Ollama > offline mock) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OLLAMA_MODEL=llama3.1
# OLLAMA_HOST=http://localhost:11434

# --- Text-to-speech (priority: ElevenLabs > Azure > gTTS > pyttsx3 > silent) ---
# pyttsx3 and gTTS are now enabled by default in requirements.txt, so a
# fresh `pip install -r requirements.txt` alone is enough to get real
# narration instead of silence - no key needed unless you want ElevenLabs
# or Azure quality.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus
# AZURE_VOICE_NAME=en-US-JennyNeural

# --- RAG retrieval backend ---
# tfidf (default): offline, zero model download, works immediately.
# dense: sentence-transformers embeddings in a FAISS vector index - a real
#   vector database, and better semantic recall (matches by meaning, not
#   just shared keywords). Needs `pip install sentence-transformers faiss-cpu`
#   and downloads ~90MB of model weights on first use.
# EMBEDDING_BACKEND=dense

# --- Speech-to-text (for voice answers to checkpoint questions) ---
# faster-whisper runs by default once installed - fully offline, no key.
# WHISPER_MODEL_SIZE=base       # tiny/base/small/medium/large-v3; bigger = more accurate, slower
# Set OPENAI_API_KEY (see above) to use the hosted Whisper API instead.

# --- App ---
# PORT=5000
# FLASK_DEBUG=0
